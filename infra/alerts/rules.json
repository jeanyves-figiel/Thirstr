{
  "_doc": "On-call alert rules (EN-06, #165). Evaluated every 5 min by .github/workflows/oncall.yml via scripts/ops/oncall.py. Each rule's runbook section is docs/runbooks/alerts.md#<id> (CI checks it exists). sev 1 = page any hour (Pushover emergency, repeats until acknowledged); sev 2 = normal push (respects Pushover quiet hours); sev 3 = job summary only, no push. PromQL rules fire when the query returns at least one sample. Burn rules (EN-23 OB-5): multi-window SLO burn rate from `bad`/`good` + `total` templates (`$W` = window), see oncall.py › burn_query.",
  "prometheus": "https://api.fly.io/prometheus/thirstr",
  "rules": [
    {
      "id": "api-down",
      "title": "API down",
      "sev": 1,
      "type": "http",
      "url": "https://api.thirstr.fun/v1/health",
      "expect_status": 200,
      "for_min": 4
    },
    {
      "id": "api-errors",
      "title": "API 5xx above 2 %",
      "sev": 1,
      "type": "promql",
      "query": "(sum(rate(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",status=~\"5..\"}[5m])) / sum(rate(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\"}[5m])) > 0.02) and on() sum(rate(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\"}[5m])) > 0.05",
      "unit": "ratio",
      "for_min": 5
    },
    {
      "id": "push-queue-stuck",
      "title": "Push jobs stuck (SOS / check-in alerts late)",
      "sev": 1,
      "type": "promql",
      "query": "max(thirstr_oban_jobs_oldest_available_s{app=\"thirstr-api-prod\",queue=\"push\"}) > 120",
      "unit": "s",
      "for_min": 5
    },
    {
      "id": "api-slow",
      "title": "API p95 above 500 ms",
      "sev": 2,
      "type": "promql",
      "query": "histogram_quantile(0.95, sum by (le) (rate(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\"}[5m]))) > 500 and on() sum(rate(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\"}[5m])) > 0.05",
      "unit": "ms",
      "for_min": 10
    },
    {
      "id": "push-failing",
      "title": "Push sends retrying above 5 %",
      "sev": 2,
      "type": "promql",
      "query": "sum(rate(thirstr_push_send_count{app=\"thirstr-api-prod\",outcome=\"retry\"}[10m])) / sum(rate(thirstr_push_send_count{app=\"thirstr-api-prod\"}[10m])) > 0.05",
      "unit": "ratio",
      "for_min": 10
    },
    {
      "id": "jobs-stuck",
      "title": "Background jobs waiting over 10 min",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_oban_jobs_oldest_available_s{app=\"thirstr-api-prod\",queue!=\"push\"}) > 600",
      "unit": "s",
      "for_min": 5
    },
    {
      "id": "valkey-down",
      "title": "Valkey unreachable (rate limits on fallback)",
      "sev": 2,
      "type": "promql",
      "query": "sum(increase(thirstr_valkey_fallback_count{app=\"thirstr-api-prod\"}[5m])) > 0",
      "unit": "count",
      "for_min": 5
    },
    {
      "id": "db-filling",
      "title": "Database above 2.2 GB (volume 3 GB)",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_db_size_bytes{app=\"thirstr-api-prod\"}) > 2.2e9",
      "unit": "bytes",
      "for_min": 30
    },
    {
      "id": "db-corruption",
      "title": "Database corruption detected (page checksum or index check failed)",
      "sev": 1,
      "type": "promql",
      "query": "max(thirstr_db_health_checksum_failures{app=\"thirstr-api-prod\"}) > 0 or min(thirstr_db_maint_ok{app=\"thirstr-api-prod\",key=\"amcheck\"}) == 0",
      "unit": "count",
      "for_min": 1
    },
    {
      "id": "db-archive-failing",
      "title": "WAL archive failing (point-in-time restore at risk)",
      "sev": 1,
      "type": "promql",
      "query": "max(thirstr_db_health_archive_failing{app=\"thirstr-api-prod\"}) > 0 or max(thirstr_db_health_archive_age_s{app=\"thirstr-api-prod\"}) > 900",
      "unit": "s",
      "for_min": 10
    },
    {
      "id": "db-backup-old",
      "title": "Database backup older than 30 h or verify failing",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_db_maint_age_s{app=\"thirstr-api-prod\",key=\"backup\"}) > 108000 or max(thirstr_db_maint_age_s{app=\"thirstr-api-prod\",key=\"verify\"}) > 691200 or min(thirstr_db_maint_ok{app=\"thirstr-api-prod\",key=~\"backup|verify\"}) == 0",
      "unit": "s",
      "for_min": 30
    },
    {
      "id": "db-xid-age",
      "title": "Transaction ID age above 500 M (wraparound at 2.1 B)",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_db_health_xid_age{app=\"thirstr-api-prod\"}) > 5e8",
      "unit": "xids",
      "for_min": 30
    },
    {
      "id": "db-long-xact",
      "title": "A database transaction open over 10 min",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_db_health_longest_xact_s{app=\"thirstr-api-prod\"}) > 600",
      "unit": "s",
      "for_min": 5
    },
    {
      "id": "db-connections",
      "title": "Database connections above 80 %",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_db_health_connections_ratio{app=\"thirstr-api-prod\"}) > 0.8",
      "unit": "ratio",
      "for_min": 10
    },
    {
      "id": "db-maintenance-stale",
      "title": "Nightly DB maintenance failed or did not run",
      "sev": 3,
      "type": "promql",
      "query": "max(thirstr_db_maint_age_s{app=\"thirstr-api-prod\",key=\"maintenance\"}) > 108000 or min(thirstr_db_maint_ok{app=\"thirstr-api-prod\",key=\"maintenance\"}) == 0",
      "unit": "s",
      "for_min": 30
    },
    {
      "id": "db-dead-tuples",
      "title": "A table has over 20 % dead rows (vacuum behind)",
      "sev": 3,
      "type": "promql",
      "query": "max(thirstr_db_health_dead_ratio{app=\"thirstr-api-prod\"}) > 0.2",
      "unit": "ratio",
      "for_min": 120
    },
    {
      "id": "machine-memory",
      "title": "API machine memory above 400 MB",
      "sev": 2,
      "type": "promql",
      "query": "max(vm_memory_total{app=\"thirstr-api-prod\"}) > 400e6",
      "unit": "bytes",
      "for_min": 10
    },
    {
      "id": "retention-overdue",
      "title": "Data kept past its retention deadline",
      "sev": 2,
      "type": "promql",
      "query": "max(thirstr_retention_overdue{app=\"thirstr-api-prod\"}) > 0",
      "unit": "rows",
      "for_min": 60
    },
    {
      "id": "app-crash-rate",
      "title": "App crash-free sessions below 99.5 %",
      "sev": 2,
      "type": "promql",
      "query": "(sum(increase(thirstr_client_error_count{app=\"thirstr-api-prod\",fatal=\"true\"}[1h])) / sum(increase(thirstr_client_session_count{app=\"thirstr-api-prod\"}[1h])) > 0.005) and on() sum(increase(thirstr_client_session_count{app=\"thirstr-api-prod\"}[1h])) >= 50",
      "unit": "ratio",
      "for_min": 30
    },
    {
      "id": "slo-1-fast",
      "title": "SLO-1 fast burn: API available",
      "sev": 1,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\"}[$W]))",
      "bad": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",status=~\"5..\"}[$W]))",
      "objective": 0.999,
      "long": "1h",
      "short": "5m",
      "factor": 14.4,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-1-slow",
      "title": "SLO-1 slow burn: API available",
      "sev": 1,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\"}[$W]))",
      "bad": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",status=~\"5..\"}[$W]))",
      "objective": 0.999,
      "long": "6h",
      "short": "30m",
      "factor": 6,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-1-drain",
      "title": "SLO-1 budget draining: API available",
      "sev": 3,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\"}[$W]))",
      "bad": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",status=~\"5..\"}[$W]))",
      "objective": 0.999,
      "long": "3d",
      "short": "6h",
      "factor": 1,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-3-fast",
      "title": "SLO-3 fast burn: Messages relay fast (send + pull < 500 ms)",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",route=\"/v1/mls/messages\"}[$W]))",
      "good": "sum(increase(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\",route=\"/v1/mls/messages\",le=\"500\"}[$W]))",
      "objective": 0.95,
      "long": "1h",
      "short": "5m",
      "factor": 14.4,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-3-slow",
      "title": "SLO-3 slow burn: Messages relay fast (send + pull < 500 ms)",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",route=\"/v1/mls/messages\"}[$W]))",
      "good": "sum(increase(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\",route=\"/v1/mls/messages\",le=\"500\"}[$W]))",
      "objective": 0.95,
      "long": "6h",
      "short": "30m",
      "factor": 6,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-3-drain",
      "title": "SLO-3 budget draining: Messages relay fast (send + pull < 500 ms)",
      "sev": 3,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",route=\"/v1/mls/messages\"}[$W]))",
      "good": "sum(increase(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\",route=\"/v1/mls/messages\",le=\"500\"}[$W]))",
      "objective": 0.95,
      "long": "3d",
      "short": "6h",
      "factor": 1,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-4-fast",
      "title": "SLO-4 fast burn: Map and grid load fast (< 300 ms)",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",route=~\"/v1/explore/(grid|map|tray|summary)\"}[$W]))",
      "good": "sum(increase(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\",route=~\"/v1/explore/(grid|map|tray|summary)\",le=\"300\"}[$W]))",
      "objective": 0.95,
      "long": "1h",
      "short": "5m",
      "factor": 14.4,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-4-slow",
      "title": "SLO-4 slow burn: Map and grid load fast (< 300 ms)",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",route=~\"/v1/explore/(grid|map|tray|summary)\"}[$W]))",
      "good": "sum(increase(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\",route=~\"/v1/explore/(grid|map|tray|summary)\",le=\"300\"}[$W]))",
      "objective": 0.95,
      "long": "6h",
      "short": "30m",
      "factor": 6,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-4-drain",
      "title": "SLO-4 budget draining: Map and grid load fast (< 300 ms)",
      "sev": 3,
      "type": "burn",
      "total": "sum(increase(phoenix_router_dispatch_stop_duration_count{app=\"thirstr-api-prod\",route=~\"/v1/explore/(grid|map|tray|summary)\"}[$W]))",
      "good": "sum(increase(phoenix_router_dispatch_stop_duration_bucket{app=\"thirstr-api-prod\",route=~\"/v1/explore/(grid|map|tray|summary)\",le=\"300\"}[$W]))",
      "objective": 0.95,
      "long": "3d",
      "short": "6h",
      "factor": 1,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-5-fast",
      "title": "SLO-5 fast burn: App crash-free sessions",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(thirstr_client_session_count{app=\"thirstr-api-prod\"}[$W]))",
      "bad": "sum(increase(thirstr_client_error_count{app=\"thirstr-api-prod\",fatal=\"true\"}[$W]))",
      "objective": 0.995,
      "long": "1h",
      "short": "5m",
      "factor": 14.4,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-5-slow",
      "title": "SLO-5 slow burn: App crash-free sessions",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(thirstr_client_session_count{app=\"thirstr-api-prod\"}[$W]))",
      "bad": "sum(increase(thirstr_client_error_count{app=\"thirstr-api-prod\",fatal=\"true\"}[$W]))",
      "objective": 0.995,
      "long": "6h",
      "short": "30m",
      "factor": 6,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-5-drain",
      "title": "SLO-5 budget draining: App crash-free sessions",
      "sev": 3,
      "type": "burn",
      "total": "sum(increase(thirstr_client_session_count{app=\"thirstr-api-prod\"}[$W]))",
      "bad": "sum(increase(thirstr_client_error_count{app=\"thirstr-api-prod\",fatal=\"true\"}[$W]))",
      "objective": 0.995,
      "long": "3d",
      "short": "6h",
      "factor": 1,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-7-fast",
      "title": "SLO-7 fast burn: Messages arrive within 1 s when the recipient is online",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(thirstr_chat_delivery_duration_ms_count{app=\"thirstr-api-prod\",recipient=\"online\"}[$W]))",
      "good": "sum(increase(thirstr_chat_delivery_duration_ms_bucket{app=\"thirstr-api-prod\",recipient=\"online\",le=\"1000\"}[$W]))",
      "objective": 0.99,
      "long": "1h",
      "short": "5m",
      "factor": 14.4,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-7-slow",
      "title": "SLO-7 slow burn: Messages arrive within 1 s when the recipient is online",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(thirstr_chat_delivery_duration_ms_count{app=\"thirstr-api-prod\",recipient=\"online\"}[$W]))",
      "good": "sum(increase(thirstr_chat_delivery_duration_ms_bucket{app=\"thirstr-api-prod\",recipient=\"online\",le=\"1000\"}[$W]))",
      "objective": 0.99,
      "long": "6h",
      "short": "30m",
      "factor": 6,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-7-drain",
      "title": "SLO-7 budget draining: Messages arrive within 1 s when the recipient is online",
      "sev": 3,
      "type": "burn",
      "total": "sum(increase(thirstr_chat_delivery_duration_ms_count{app=\"thirstr-api-prod\",recipient=\"online\"}[$W]))",
      "good": "sum(increase(thirstr_chat_delivery_duration_ms_bucket{app=\"thirstr-api-prod\",recipient=\"online\",le=\"1000\"}[$W]))",
      "objective": 0.99,
      "long": "3d",
      "short": "6h",
      "factor": 1,
      "min_total": 100,
      "for_min": 0
    },
    {
      "id": "slo-7-fast-staging",
      "title": "SLO-7 fast burn on staging (testers): messages slow to arrive",
      "sev": 2,
      "type": "burn",
      "total": "sum(increase(thirstr_chat_delivery_duration_ms_count{app=\"thirstr-api-staging\",recipient=\"online\"}[$W]))",
      "good": "sum(increase(thirstr_chat_delivery_duration_ms_bucket{app=\"thirstr-api-staging\",recipient=\"online\",le=\"1000\"}[$W]))",
      "objective": 0.99,
      "long": "1h",
      "short": "5m",
      "factor": 14.4,
      "min_total": 50,
      "for_min": 0
    },
    {
      "id": "messages-stuck-online",
      "title": "Messages waiting over 2 min while the phone is connected",
      "sev": 1,
      "type": "promql",
      "query": "sum(thirstr_chat_stuck_online{app=\"thirstr-api-prod\"}) > 0",
      "unit": "count",
      "for_min": 10
    },
    {
      "id": "messages-stuck-online-staging",
      "title": "Staging: messages stuck while the phone is connected",
      "sev": 2,
      "type": "promql",
      "query": "sum(thirstr_chat_stuck_online{app=\"thirstr-api-staging\"}) > 0",
      "unit": "count",
      "for_min": 10
    },
    {
      "id": "messages-skipped",
      "title": "Phones skipped messages (later ones acked, earlier still waiting)",
      "sev": 2,
      "type": "promql",
      "query": "sum(increase(thirstr_chat_skipped_count{app=~\"thirstr-api-(prod|staging)\"}[15m])) > 0",
      "unit": "count",
      "for_min": 0
    },
    {
      "id": "messages-lost",
      "title": "Messages deleted unread by the 30-day sweep",
      "sev": 3,
      "type": "promql",
      "query": "sum(increase(thirstr_chat_expired_count{app=\"thirstr-api-prod\",kind=\"app\"}[1d])) > 0",
      "unit": "count",
      "for_min": 0
    },
    {
      "id": "socket-flapping",
      "title": "Realtime sockets reconnecting abnormally",
      "sev": 2,
      "type": "promql",
      "query": "(sum(rate(thirstr_socket_close_count{app=\"thirstr-api-prod\",reason!=\"normal\"}[10m])) * 60 / sum(thirstr_socket_live{app=\"thirstr-api-prod\"}) > 1) and on() sum(thirstr_socket_live{app=\"thirstr-api-prod\"}) >= 5",
      "unit": "",
      "for_min": 10
    },
    {
      "id": "traffic-cliff",
      "title": "Messages sent dropped over 80 % vs same hour last week",
      "sev": 2,
      "type": "promql",
      "query": "(sum(increase(thirstr_chat_send_count{app=\"thirstr-api-prod\",result=\"stored\"}[1h])) or on() vector(0)) < 0.2 * sum(increase(thirstr_chat_send_count{app=\"thirstr-api-prod\",result=\"stored\"}[1h] offset 1w)) and on() sum(increase(thirstr_chat_send_count{app=\"thirstr-api-prod\",result=\"stored\"}[1h] offset 1w)) >= 50",
      "unit": "count",
      "for_min": 15
    },
    {
      "id": "push-slow-provider",
      "title": "Push provider calls slow (p95 above 2 s)",
      "sev": 2,
      "type": "promql",
      "query": "histogram_quantile(0.95, sum by (le) (rate(thirstr_push_provider_duration_ms_bucket{app=\"thirstr-api-prod\"}[15m]))) > 2000 and on() sum(rate(thirstr_push_provider_duration_ms_count{app=\"thirstr-api-prod\"}[15m])) > 0.01",
      "unit": "ms",
      "for_min": 15
    },
    {
      "id": "tls-expiring",
      "title": "TLS certificate expires in under 14 days",
      "sev": 2,
      "type": "cert",
      "hosts": [
        "api.thirstr.fun",
        "thirstr.fun"
      ],
      "min_days": 14,
      "for_min": 30
    },
    {
      "id": "metrics-unreachable",
      "title": "Metrics unreachable (alerts blind)",
      "sev": 2,
      "type": "meta",
      "for_min": 15
    },
    {
      "id": "chat-backlog-old",
      "title": "Undelivered chat ciphertext near the 30-day sweep",
      "sev": 3,
      "type": "promql",
      "query": "max(thirstr_chat_backlog_oldest_s{app=\"thirstr-api-prod\"}) > 86400 * 25",
      "unit": "s",
      "for_min": 60
    }
  ]
}
