# DEV image: toolchain only; source is bind-mounted by docker compose.
FROM hexpm/elixir:1.17.3-erlang-27.1.2-debian-bookworm-20241016-slim
RUN apt-get update -y && apt-get install -y --no-install-recommends build-essential git inotify-tools ca-certificates \
 && rm -rf /var/lib/apt/lists/*
RUN mix local.hex --force && mix local.rebar --force
WORKDIR /app
